{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Service Manager",
  "version": "0.1.0",
  "identifier": "com.servicemanager.rs",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Service Manager",
        "width": 1180,
        "height": 720,
        "minWidth": 920,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Service Manager - NSSM & native service manager",
    "longDescription": "GUI untuk mengelola Windows Service NSSM, Apache, dan PostgreSQL."
  }
}
